OPENAI_API_KEY=
# Point at an OpenAI-compatible server hosting your models (e.g. vLLM, Ollama, LM Studio)
OPENAI_BASE_URL=

# Per-agent model overrides (default: qwen3:8b)
COMPILER_MODEL=
CHARACTER_MODEL=
# Number of completed dialogue turns retained as short-term memory (0 disables).
HISTORY_TURNS=2
CONTEXT_MODEL=
REFLECTION_MODEL=

# none | minimal | low | medium | high | xhigh | max (unset = model default)
REASONING=
